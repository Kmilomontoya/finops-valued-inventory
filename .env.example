# INVENTARIO MENSUAL VALORIZADO — Configuración de ejemplo
# Azure FOCUS
# Copie este archivo como .env y ajuste solo en su entorno local.
# NO versionar el archivo .env real.

# ── Rutas ──────────────────────────────────────────────────────────────────
BASE_DIR=./data

# Inventario crudo exportado del tenant.
# Si la ruta no existe, el script autodetecta el primer .xlsx dentro de Input.
INVENTORY_RAW=./data/Input/*.xlsx
# Hoja a procesar (vacío = primera hoja)
INVENTORY_SHEET=

# Dataset FOCUS del mes. Acepta una carpeta o rutas separadas por coma.
FOCUS_PATHS=./data/Input
CSV_ENCODING=latin-1

# Salida: carpeta o ruta .xlsx completa.
OUTPUT_PATH=./data/Output

# ── Valorización ───────────────────────────────────────────────────────────
# EffectiveCost | BilledCost | x_EffectiveCostInUsd
COST_COLUMN=EffectiveCost

# Tipos de recurso excluidos del costeo (substring, case-insensitive).
EXCLUDE_RESOURCE_TYPES=reservation,snapshot

# ── Etiquetas canónicas ────────────────────────────────────────────────────
CANONICAL_TAGS=APPLICATION|ENVIRONMENT|TIER|CRITICALITY|SHAREDCOST|DEPARTMENT|OWNER_TECH|OWNER_TECH MAIL|OWNER_FUNC|OWNER_FUNC MAIL|BACKUPPOLICY

# ── Variantes de columnas (opcional) ───────────────────────────────────────
# VARIANTS_APPLICATION=APPLICATION|APLICATION|Aplicativo|Aplicacion

# ── Homologación APPLICATION (opcional) ────────────────────────────────────
# Use ejemplos genéricos. Los mappings reales del cliente deben quedarse solo
# en el .env local y nunca en GitHub.
HOM_APP_MAP=App Legacy>APP_LEGACY;Portal Interno>PORTAL_INTERNO

# ── Homologación ENVIRONMENT adicional (opcional) ─────────────────────────
# Los valores específicos de cada cliente se definen aquí y no en el código.
# HOM_ENV_MAP=QA>PREPROD;STAGING>PREPROD;DISASTER_RECOVERY>PROD
HOM_ENV_MAP=

# ── KPI de cobertura ───────────────────────────────────────────────────────
META_COBERTURA=80
